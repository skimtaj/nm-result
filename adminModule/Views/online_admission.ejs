<!DOCTYPE html>
<html lang="en">
<%-include('admin_sidebar')%>

    <head>
        <meta charset="UTF-8" />
        <meta name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover" />
        <title>NM - Admin Dashboard</title>

        <!-- jQuery -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

        <!-- DataTables CSS + JS -->
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
        <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css"
            integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">

        <!-- Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            }

            body {
                background: #f4f0f5;
                min-height: 100vh;
                color: #1e1a2b;
            }

            :root {
                --primary: #4F0853;
                --primary-light: #6d1a72;
                --primary-dark: #2e0431;
                --white: #ffffff;
                --shadow: 0 2px 8px rgba(79, 8, 83, 0.08);
                --shadow-md: 0 4px 16px rgba(79, 8, 83, 0.10);
                --sidebar: 260px;
            }

            .container {
                width: 100%;
                padding: 12px 16px;
                margin: 0 auto;
            }

            .main {
                display: grid;
                gap: 20px;
                width: 100%;
                margin-top: 50px;
            }

            /* ----- STATS ----- */
            .stats-row {
                display: grid;
                gap: 14px;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            }

            .stats-box {
                background: var(--white);
                padding: 0.85rem 1.25rem;
                border-radius: 12px;
                box-shadow: var(--shadow);
                border-left: 4px solid var(--primary);
            }

            .stats-value {
                font-size: 1.5rem;
                font-weight: 800;
                color: var(--primary-dark);
                margin-bottom: 0.2rem;
            }

            .stats-label {
                font-size: 0.7rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                color: #4b3f4f;
                opacity: 0.8;
            }

            /* ----- TABLE CARD ----- */
            .data-table-container {
                background: var(--white);
                border-radius: 12px;
                box-shadow: var(--shadow-md);
                padding: 1rem 1.5rem 1.5rem;
            }

            .data-table-header h3 {
                font-weight: 700;
                font-size: 1.2rem;
                color: var(--primary-dark);
                margin-bottom: 0.2rem;
            }

            .data-table-header p {
                font-size: 0.7rem;
                color: #6b5f6f;
                margin-bottom: 1rem;
            }

            /* ----- TABLE ----- */
            table {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0;
            }

            table thead th {
                padding: 14px 12px;
                background: #faf8fc;
                font-weight: 700;
                font-size: 0.72rem;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                color: var(--primary-dark);
                border-bottom: 2px solid #ede4f2;
                text-align: left;
                white-space: nowrap;
            }

            table tbody td {
                padding: 12px 12px;
                font-size: 0.85rem;
                color: #2e2a33;
                border-bottom: 1px solid #f3eef6;
                vertical-align: middle;
            }

            table tbody tr:hover {
                background: #fdfbff;
            }

            /* ----- DataTables CONTROLS (search + length) ----- */
            .dataTables_wrapper .dataTables_length,
            .dataTables_wrapper .dataTables_filter {
                margin-bottom: 1rem;
                font-size: 0.85rem;
                color: #4b3f4f;
            }

            .dataTables_wrapper .dataTables_length select,
            .dataTables_wrapper .dataTables_filter input {
                border: 1px solid #e4dae8;
                border-radius: 6px;
                padding: 0.3rem 0.6rem;
                font-size: 0.8rem;
                outline: none;
                margin-left: 0.4rem;
            }

            .dataTables_wrapper .dataTables_filter input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(79, 8, 83, 0.08);
            }

            .dataTables_wrapper .dataTables_info {
                font-size: 0.78rem;
                color: #8a7b8e;
                padding-top: 0.8rem;
            }

            .dataTables_wrapper .dataTables_paginate {
                padding-top: 0.8rem;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                border-radius: 8px !important;
                border: 1px solid #e4dae8 !important;
                background: white !important;
                color: var(--primary-dark) !important;
                font-size: 0.8rem;
                font-weight: 600;
                padding: 0.35rem 0.7rem !important;
                margin: 0 2px;
                cursor: pointer;
                transition: all 0.2s;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                border-color: var(--primary) !important;
                background: #faf5fb !important;
                color: var(--primary) !important;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current,
            .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
                background: var(--primary) !important;
                border-color: var(--primary) !important;
                color: white !important;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
                opacity: 0.4;
                cursor: not-allowed;
            }

            /* Action buttons */
            .act-btn {
                width: 30px;
                height: 30px;
                border-radius: 6px;
                border: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 0.7rem;
                cursor: pointer;
                margin-right: 4px;
            }

            .act-btn.view {
                color: var(--primary);
                background: #f3eaf6;
            }

            .act-btn.edit {
                color: #b48ab8;
                background: #faf5fb;
            }

            .act-btn.delete {
                color: #c0392b;
                background: #fdf0ef;
            }

            /* ----- RESPONSIVE ----- */
            @media (max-width:575.98px) {
                .stats-row {
                    grid-template-columns: 1fr;
                }

                .data-table-container {
                    padding: 0.6rem 0.8rem 1rem;
                }

                table thead th,
                table tbody td {
                    padding: 8px 6px;
                    font-size: 0.72rem;
                }

                .dataTables_wrapper .dataTables_length,
                .dataTables_wrapper .dataTables_filter {
                    font-size: 0.72rem;
                }
            }

            @media (min-width:992px) {
                .container {
                    margin-left: var(--sidebar);
                    padding: 24px 32px;
                    max-width: calc(100% - var(--sidebar));
                }

                .main {
                    gap: 22px;
                    margin-top: 58px;
                }

                .stats-row {
                    gap: 16px;
                }

                .stats-box {
                    padding: 1rem 1.5rem;
                }

                .stats-value {
                    font-size: 1.6rem;
                }
            }
        </style>
    </head>

    <body>

        <div class="sidebar-placeholder"></div>
        <div class="container" id="top">
            <main class="content">
                <div class="main">

                    <!-- ===== STATS ROW ===== -->
                    <div class="stats-row">
                        <div class="stats-box">
                            <h4 class="stats-value">
                                <%= allOnlineAdmissionDocuments.length %>
                            </h4>
                            <span class="stats-label">Total Applied Students</span>
                        </div>
                    </div>

                    <!-- ===== DATA TABLE ===== -->
                    <div class="data-table-container">
                        <div class="data-table-header">
                            <h3>Student Admission List</h3>
                            <p>All online admission applications</p>
                        </div>

                        <table id="masterDirectoryTable">
                            <thead>
                                <tr>
                                    <th>Serial No</th>
                                    <th>Form No</th>
                                    <th>Student Name</th>
                                    <th>Father Name</th>
                                    <th>Mobile</th>
                                    <th>Applying For Class</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% allOnlineAdmissionDocuments.forEach((oa, index)=> { %>
                                    <tr>
                                        <td>
                                            <%= index + 1 %>
                                        </td>
                                        <td>
                                            <%= oa.form_no %>
                                        </td>
                                        <td>
                                            <%= oa.student_name %>
                                        </td>
                                        <td>
                                            <%= oa.father_name %>
                                        </td>
                                        <td>
                                            <%= oa.mobile_no %>
                                        </td>
                                        <td>
                                            <%= oa.appling_for_class %>
                                        </td>
                                        <td>
                                            <a href="/delete-online-admission-candidate/<%=oa._id%>"
                                                onclick=" return confirm('Are You Sure?')" type="button"
                                                class="btn btn-primary btn-sm">Delete</a>

                                            <a href="/download-admission-form/<%=oa._id%>"
                                                onclick=" return confirm('Are You Sure?')" type="button"
                                                class="btn btn-primary btn-sm">Download</a>

                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>

                </div>
            </main>
        </div>

        <!-- ===== DataTables INIT — everything is automatic ===== -->
        <script>
            $(document).ready(function () {
                $('#masterDirectoryTable').DataTable({
                    paging: true,
                    pageLength: 10,
                    lengthMenu: [5, 10, 25, 50],
                    searching: true,
                    ordering: true,
                    info: true,
                    columnDefs: [
                        { orderable: false, targets: 0 } // Serial No column not sortable
                    ],
                    language: {
                        search: "Search:",
                        lengthMenu: "Show _MENU_ entries",
                        info: "Showing _START_–_END_ of _TOTAL_ entries",
                        infoEmpty: "No entries",
                        infoFiltered: "(filtered from _MAX_ total entries)",
                        paginate: {
                            previous: "Prev",
                            next: "Next"
                        }
                    }
                });
            });
        </script>

    </body>

</html>