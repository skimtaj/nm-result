<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <title>Thank You — Nababia Mission</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap"
    rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #4D0851;
      --primary-light: #6b1f70;
      --primary-soft: #8a4b8f;
      --bg-soft: #FEF5FF;
      --bg-card: #ffffff;
      --border-light: #e6d5e8;
      --text-dark: #2b0f2e;
      --text-muted: #6a4d6d;
      --shadow-md: 0 12px 30px -8px rgba(77, 8, 81, 0.18);
      --shadow-lg: 0 24px 50px -12px rgba(77, 8, 81, 0.35);
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(160deg, #fdf3fe 0%, #f5e6f7 100%);
      min-height: 100vh;
      padding: 1.5rem 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-dark);
      line-height: 1.5;
    }

    .thankyou-card {
      background: var(--bg-card);
      max-width: 620px;
      width: 100%;
      border-radius: 28px;
      box-shadow: var(--shadow-md);
      border: 1px solid rgba(230, 213, 232, 0.6);
      overflow: hidden;
      position: relative;
      animation: cardIn 0.5s ease-out;
    }

    @keyframes cardIn {
      from {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .card-header-strip {
      height: 8px;
      background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 60%, var(--primary-soft) 100%);
    }

    .card-inner {
      padding: 3rem 2rem;
      text-align: center;
    }

    /* Checkmark circle */
    .success-mark {
      width: 84px;
      height: 84px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.8rem;
      box-shadow: 0 12px 28px -10px rgba(77, 8, 81, 0.5);
      animation: popIn 0.5s ease-out 0.15s both;
    }

    @keyframes popIn {
      0% {
        transform: scale(0);
        opacity: 0;
      }

      60% {
        transform: scale(1.1);
      }

      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    .success-mark svg {
      width: 42px;
      height: 42px;
      stroke: #ffffff;
      stroke-width: 3;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
    }

    .success-mark svg path {
      stroke-dasharray: 40;
      stroke-dashoffset: 40;
      animation: drawCheck 0.5s ease-out 0.5s forwards;
    }

    @keyframes drawCheck {
      to {
        stroke-dashoffset: 0;
      }
    }

    h1 {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--primary);
      letter-spacing: -0.02em;
      margin-bottom: 0.75rem;
      line-height: 1.25;
    }

    .message {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 2.2rem;
      line-height: 1.7;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    .message strong {
      color: var(--text-dark);
      font-weight: 600;
    }

    /* Bengali note styling */
    .message .bn-note {
      display: block;
      margin-top: 0.6rem;
      font-size: 0.88rem;
      color: #5a3b5c;
      font-weight: 500;
      background: #faf0fc;
      padding: 0.6rem 1rem;
      border-radius: 12px;
      border-left: 3px solid var(--primary-soft);
      text-align: left;
    }

    .message .bn-note i {
      font-style: normal;
      display: block;
      margin-bottom: 0.3rem;
    }

    .message .bn-note i:last-child {
      margin-bottom: 0;
    }

    /* ----- BUTTON GROUP ----- */
    .button-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.7rem;
      width: 100%;
    }

    /* ----- DOWNLOAD BUTTON (primary) ----- */
    .btn-download,
    .btn-back {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.9rem;
      font-family: 'Inter', sans-serif;
      letter-spacing: 0.3px;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease, color 0.2s ease;
      text-decoration: none;
      width: 100%;
      max-width: 300px;
      height: 42px;
      padding: 0 1.8rem;
      line-height: 1;
    }

    .btn-download {
      background: var(--primary);
      color: #ffffff;
      border: none;
      box-shadow: 0 8px 18px -8px rgba(77, 8, 81, 0.45);
    }

    .btn-download:hover {
      background: var(--primary-light);
      transform: translateY(-2px);
      box-shadow: 0 14px 24px -10px rgba(77, 8, 81, 0.55);
    }

    .btn-download:active {
      transform: translateY(1px);
      box-shadow: 0 4px 10px -4px rgba(77, 8, 81, 0.45);
    }

    .btn-download svg {
      width: 16px;
      height: 16px;
      stroke: #ffffff;
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
      flex-shrink: 0;
    }

    /* ----- BACK BUTTON (secondary / outline) ----- */
    .btn-back {
      background: transparent;
      color: var(--primary);
      border: 1.5px solid var(--border-light);
    }

    .btn-back:hover {
      background: var(--bg-soft);
      border-color: var(--primary);
      color: var(--primary);
      transform: translateY(-2px);
      box-shadow: 0 8px 18px -10px rgba(77, 8, 81, 0.25);
    }

    .btn-back:active {
      transform: translateY(1px);
      box-shadow: none;
    }

    .btn-back svg {
      width: 15px;
      height: 15px;
      stroke: currentColor;
      stroke-width: 2.4;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
      flex-shrink: 0;
    }

    /* Responsive */
    @media (min-width: 520px) {
      .card-inner {
        padding: 3.5rem 3rem;
      }

      h1 {
        font-size: 2rem;
      }

      .success-mark {
        width: 96px;
        height: 96px;
      }

      .success-mark svg {
        width: 48px;
        height: 48px;
      }

      .button-group {
        flex-direction: row;
        justify-content: center;
        gap: 0.8rem;
      }

      .btn-download,
      .btn-back {
        height: 44px;
        font-size: 0.92rem;
        padding: 0 2rem;
        width: auto;
        min-width: 180px;
      }
    }

    @media (max-width: 380px) {
      .card-inner {
        padding: 2.2rem 1.4rem;
      }

      h1 {
        font-size: 1.4rem;
      }

      .message {
        font-size: 0.88rem;
        margin-bottom: 1.8rem;
      }

      .success-mark {
        width: 72px;
        height: 72px;
        margin-bottom: 1.4rem;
      }

      .success-mark svg {
        width: 36px;
        height: 36px;
      }

      .btn-download,
      .btn-back {
        height: 38px;
        font-size: 0.85rem;
        padding: 0 1.4rem;
      }

      .btn-download svg,
      .btn-back svg {
        width: 14px;
        height: 14px;
      }

      .message .bn-note {
        font-size: 0.82rem;
        padding: 0.5rem 0.8rem;
      }
    }
  </style>
</head>

<body>

  <% if (messages.success) { %>
    <script>
      Swal.fire({
        toast: true,
        position: "top-end",
        icon: "success",
        title: "<%= messages.success %>",
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        background: "#ffffff",
        iconColor: "#00b894",
        color: "#333",
        customClass: {
          popup: 'custom-swal-toast'
        },
        didOpen: (toast) => {
          toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1)';
          toast.style.borderRadius = '8px';
          toast.style.padding = '0.75rem 1.25rem';
        }
      });
    </script>
    <% } %>

      <% if (messages.error) { %>
        <script>
          Swal.fire({
            toast: true,
            position: "top-end",
            icon: "error",
            title: "<%= messages.error %>",
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            background: "#ffffff",
            iconColor: "#e74c3c",
            color: "#333",
            customClass: {
              popup: 'custom-swal-toast'
            },
            didOpen: (toast) => {
              toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1)';
              toast.style.borderRadius = '8px';
              toast.style.padding = '0.75rem 1.25rem';
            }
          });
        </script>
        <% } %>

          <div class="thankyou-card">
            <div class="card-header-strip"></div>
            <div class="card-inner">

              <!-- Animated success checkmark -->
              <div class="success-mark">
                <svg viewBox="0 0 24 24">
                  <path d="M4 12.5 L9.5 18 L20 6.5" />
                </svg>
              </div>

              <h1>Thank You for Submitting!</h1>

              <!-- Perfectly crafted message -->
              <p class="message">
                Your admission form has been received successfully. You can now
                <strong>download a copy of your submitted form</strong> for your records.
                <span class="bn-note">
                  <i>📄 ডাউনলোড করা ফর্মটির হার্ড কপি অবশ্যই পরীক্ষা দেওয়ার আগে অফিসে জমা দিতে হবে।</i>
                  <i>📄 ফর্ম মূল্য ২৫০ টাকা</i>
                  <i>📄 বাকি নির্দেশিকাগুলি অ্যাডমিশন ফর্মে উল্লেখ আছে।</i>
                </span>
              </p>

              <!-- BUTTON GROUP -->
              <div class="button-group">

                <!-- Download button — replace href with your PDF download link -->
                <a href="/download-admission-form/<%=studentSourse.id%>" class="btn-download" id="downloadBtn">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 3v12" />
                    <path d="M7 11l5 5 5-5" />
                    <path d="M4 20h16" />
                  </svg>
                  Download Your Form
                </a>

                <!-- Back button — replace href with your form page URL -->
                <a href="javascript:history.back()" class="btn-back" id="backBtn">
                  <svg viewBox="0 0 24 24">
                    <path d="M19 12H5" />
                    <path d="M12 19l-7-7 7-7" />
                  </svg>
                  Go Back
                </a>

              </div>

            </div>
          </div>

</body>

</html>