<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Sign Up - Nababia Mission</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Roboto, system-ui, sans-serif;
        }

        html,
        body {
            height: 100%;
            width: 100%;
            background: #f2ebf5;
        }

        body {
            display: flex;
            min-height: 100vh;
        }

        .auth-container {
            display: flex;
            width: 100%;
            min-height: 100vh;
            flex-direction: row-reverse;
        }

        /* ----- LEFT PANEL : FULL COVER IMAGE, EDGE TO EDGE ----- */
        .auth-left {
            flex: 1 1 50%;
            width: 50%;
            height: 100vh;
            background: #1e0a24;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 0;
            margin: 0;
            position: relative;
        }

        .auth-left-content {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            margin: 0;
            line-height: 0;
            flex-shrink: 0;
        }

        .auth-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            border-radius: 0;
            box-shadow: none;
            margin: 0;
            padding: 0;
            vertical-align: bottom;
            min-width: 100%;
            min-height: 100%;
            flex-shrink: 0;
        }

        /* ----- RIGHT PANEL (signup form) – takes other 50% ----- */
        .auth-right {
            flex: 1 1 50%;
            width: 50%;
            min-height: 100vh;
            background-color: #f8f4fc;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        .auth-right::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #510855, #2d1040);
            clip-path: circle(40% at 90% 10%);
            z-index: 1;
            opacity: 0.06;
        }

        .auth-right::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #510855, #2d1040);
            clip-path: circle(30% at 10% 90%);
            z-index: 1;
            opacity: 0.06;
        }

        .auth-content {
            max-width: 400px;
            width: 100%;
            z-index: 2;
        }

        .logo {
            display: flex;
            align-items: center;
            margin-bottom: 2rem;
        }

        .logo img {
            height: 40px;
            margin-right: 10px;
            border-radius: 8px;
            border: 2px solid #510855;
            object-fit: cover;
        }

        .logo h1 {
            font-size: 1.5rem;
            color: #1e0a24;
            font-weight: 700;
        }

        .admin-badge {
            background-color: #510855;
            color: white;
            padding: 0.2rem 0.7rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-left: 0.5rem;
            letter-spacing: 0.3px;
        }

        .auth-form {
            background-color: #ffffff;
            padding: 2rem;
            border-radius: 18px;
            box-shadow: 0 12px 30px rgba(81, 8, 85, 0.12);
            border: 1px solid rgba(81, 8, 85, 0.06);
        }

        .auth-header {
            margin-bottom: 1.5rem;
        }

        .auth-header h2 {
            font-size: 1.5rem;
            color: #1e0a24;
            margin-bottom: 0.4rem;
        }

        .auth-header p {
            color: #6b4a72;
            font-size: 0.875rem;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
            color: #1e0a24;
            font-weight: 500;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid #dacce0;
            border-radius: 10px;
            font-size: 0.875rem;
            transition: all 0.25s ease;
            background-color: #fcf9fd;
        }

        .form-control:focus {
            outline: none;
            border-color: #510855;
            box-shadow: 0 0 0 4px rgba(81, 8, 85, 0.15);
            background-color: #ffffff;
        }

        .input-with-icon {
            position: relative;
        }

        .input-with-icon .form-control {
            padding-left: 2.8rem;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #6b4a72;
            font-size: 1rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.8rem 1.5rem;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            border: none;
            letter-spacing: 0.3px;
        }

        .btn-primary {
            background-color: #510855;
            color: white;
            width: 100%;
            box-shadow: 0 6px 14px rgba(81, 8, 85, 0.25);
        }

        .btn-primary:hover {
            background-color: #7a2a7e;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(81, 8, 85, 0.3);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .auth-footer {
            margin-top: 1.5rem;
            text-align: center;
            font-size: 0.875rem;
            color: #6b4a72;
        }

        .auth-footer a {
            color: #510855;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }

        .auth-footer a:hover {
            text-decoration: underline;
            color: #7a2a7e;
        }

        .password-toggle {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #6b4a72;
            font-size: 1rem;
        }

        .password-toggle:hover {
            color: #510855;
        }

        .error-message {
            color: #e84c6b;
            font-size: 0.75rem;
            margin-top: 0.25rem;
            display: none;
        }

        .form-group.error .error-message {
            display: block;
        }

        .form-group.error .form-control {
            border-color: #e84c6b;
        }

        .form-group.success .form-control {
            border-color: #00b894;
        }

        /* Password strength */
        .password-strength {
            margin-top: 0.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .strength-bar {
            flex: 1;
            height: 4px;
            background: #e2e8f0;
            border-radius: 20px;
            overflow: hidden;
        }

        .strength-fill {
            height: 100%;
            width: 0%;
            border-radius: 20px;
            transition: width 0.3s ease, background 0.3s ease;
        }

        .strength-text {
            font-size: 0.65rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #94a3b8;
            padding: 2px 10px;
            border-radius: 40px;
            white-space: nowrap;
            min-width: 36px;
            text-align: center;
            background: #f1f5f9;
        }

        .requirements {
            display: flex;
            flex-wrap: wrap;
            gap: 4px 8px;
            margin-top: 0.5rem;
        }

        .req-item {
            font-size: 0.65rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 4px;
            color: #94a3b8;
            background: #f1f5f9;
            padding: 2px 10px 2px 8px;
            border-radius: 30px;
            border: 1px solid transparent;
            transition: all 0.25s ease;
        }

        .req-item i {
            font-size: 0.5rem;
            color: #cbd5e1;
        }

        .req-item.valid {
            background: #ecfdf5;
            border-color: #6ee7b7;
            color: #065f46;
        }

        .req-item.valid i {
            color: #10b981;
        }

        /* ----- MODALS (light) ----- */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(30, 10, 36, 0.5);
            backdrop-filter: blur(4px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: white;
            padding: 2rem 2rem 2.2rem;
            border-radius: 24px;
            width: 90%;
            max-width: 440px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
            position: relative;
            border: 1px solid rgba(81, 8, 85, 0.08);
        }

        .close-modal {
            position: absolute;
            top: 1rem;
            right: 1.2rem;
            font-size: 1.6rem;
            cursor: pointer;
            color: #6b4a72;
            transition: 0.2s;
            line-height: 1;
        }

        .close-modal:hover {
            color: #1e0a24;
            transform: rotate(90deg);
        }

        .modal-header {
            margin-bottom: 1.5rem;
        }

        .modal-header h2 {
            font-size: 1.5rem;
            color: #1e0a24;
            margin-bottom: 0.4rem;
        }

        .modal-header p {
            color: #6b4a72;
            font-size: 0.9rem;
        }

        /* ===== RESPONSIVE: on smaller screens stack vertically ===== */
        @media (max-width: 1024px) {
            .auth-container {
                flex-direction: column;
            }

            .auth-left {
                width: 100%;
                height: 40vh;
                flex: none;
            }

            .auth-right {
                width: 100%;
                min-height: 60vh;
                flex: none;
            }

            .auth-image {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }

        @media (max-width: 480px) {
            .auth-form {
                padding: 1.25rem;
            }

            .auth-content {
                padding: 0.25rem;
            }

            .logo h1 {
                font-size: 1.2rem;
            }

            .auth-header h2 {
                font-size: 1.2rem;
            }

            .form-control {
                padding: 0.6rem 0.8rem;
            }

            .input-with-icon .form-control {
                padding-left: 2.4rem;
            }

            .btn {
                padding: 0.6rem 1rem;
            }

            .modal-content {
                padding: 1.5rem;
            }

            .auth-right {
                padding: 1rem;
            }

            .auth-left {
                height: 30vh;
                padding: 0;
            }
        }
    </style>
</head>

<body>

    <% if (messages.success) { %>
        <script>
            Swal.fire({
                toast: true,
                position: "top-end",
                icon: "success",
                title: "<%= messages.success %>",
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                background: "#ffffff",
                iconColor: "#00b894",
                color: "#333",
                customClass: {
                    popup: 'custom-swal-toast'
                },
                didOpen: (toast) => {
                    toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1)';
                    toast.style.borderRadius = '8px';
                    toast.style.padding = '0.75rem 1.25rem';
                }
            });
        </script>
    <% } %>

    <% if (messages.error) { %>
        <script>
            Swal.fire({
                toast: true,
                position: "top-end",
                icon: "error",
                title: "<%= messages.error %>",
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                background: "#ffffff",
                iconColor: "#e84c6b",
                color: "#333",
                customClass: {
                    popup: 'custom-swal-toast'
                },
                didOpen: (toast) => {
                    toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1)';
                    toast.style.borderRadius = '8px';
                    toast.style.padding = '0.75rem 1.25rem';
                }
            });
        </script>
    <% } %>

    <div class="auth-container">

        <!-- LEFT PANEL : IMAGE FULL COVER -->
        <div class="auth-left">
            <div class="auth-left-content">
                <img src="https://nababiamission.org/wp-content/uploads/2026/06/A2.jpeg"
                    alt="Nababia Mission" class="auth-image">
            </div>
        </div>

        <!-- RIGHT PANEL : SIGNUP FORM -->
        <div class="auth-right">
            <div class="auth-content">
              
                <div class="auth-form">
                    <div class="auth-header">
                        <h2>Admin Sign Up</h2>
                       
                    </div>

                    <form id="signupForm" method="post" action="/nababiamission/admin-signup/SSSSS">
                        <div class="form-group">
                            <label for="signup-name">Full Name</label>
                            <div class="input-with-icon">
                                <i class="fas fa-user input-icon"></i>
                                <input type="text" id="signup-name" class="form-control"
                                    placeholder="Enter full name" required name="name">
                            </div>
                            <div class="error-message">Please enter your full name</div>
                        </div>

                        <div class="form-group">
                            <label for="signup-email">Email Address</label>
                            <div class="input-with-icon">
                                <i class="fas fa-envelope input-icon"></i>
                                <input type="email" id="signup-email" class="form-control"
                                    placeholder="admin@domain.com" required name="email">
                            </div>
                            <div class="error-message">Please enter a valid email address</div>
                        </div>

                        <div class="form-group">
                            <label for="signup-mobile">Mobile Number</label>
                            <div class="input-with-icon">
                                <i class="fas fa-phone input-icon"></i>
                                <input type="tel" id="signup-mobile" class="form-control"
                                    placeholder="Enter mobile number" required name="mobile">
                            </div>
                            <div class="error-message">Please enter a valid mobile number</div>
                        </div>

                        <div class="form-group">
                            <label for="signup-password">Password</label>
                            <div class="input-with-icon">
                                <i class="fas fa-lock input-icon"></i>
                                <input type="password" id="signup-password" class="form-control"
                                    placeholder="Create a strong password" required name="password">
                                <i class="fas fa-eye password-toggle" id="toggleSignupPassword"></i>
                            </div>
                            
                           
                            
                            <div class="error-message">Password must meet all requirements above</div>
                        </div>

                        

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-user-plus" style="margin-right: 8px;"></i> Create Account
                        </button>
                    </form>

                    <div class="auth-footer">
                        <span>Secure connection</span> ·
                        <a href="#" id="openHelp" style="color: #510855; font-weight: 600;">Need help?</a>
                        <span style="margin:0 0.25rem;">·</span>
                        <a href="/nababiamission/nm-admin" style="color: #510855; font-weight: 600;">
                            <i class="fas fa-sign-in-alt"></i> Sign In
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HELP MODAL (Need help?) -->
    <div class="modal" id="helpModal">
        <div class="modal-content">
            <span class="close-modal" id="closeHelp">&times;</span>
            <div class="modal-header">
                <h2>Admin Support</h2>
                <p>Contact the system administrator for assistance.</p>
            </div>
            <div style="padding: 0.5rem 0 0.8rem;">
                <p style="color: #6b4a72;"><i class="fas fa-phone-alt" style="color: #510855;"></i> +917797593863 (Sk Imtaj)</p>
            </div>
            <button class="btn btn-primary" style="width: auto; padding: 0.5rem 2rem; margin-top: 0.5rem;" id="closeHelpBtn">Close</button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // DOM refs
            const signupPassword = document.getElementById('signup-password');
            const confirmPassword = document.getElementById('signup-confirm');
            const toggleSignupPassword = document.getElementById('toggleSignupPassword');
            const strengthFill = document.getElementById('strengthFill');
            const strengthLabel = document.getElementById('strengthLabel');

            // Requirement elements
            const reqLength = document.getElementById('reqLength');
            const reqUpper = document.getElementById('reqUpper');
            const reqLower = document.getElementById('reqLower');
            const reqNumber = document.getElementById('reqNumber');
            const reqSpecial = document.getElementById('reqSpecial');

            const helpModal = document.getElementById('helpModal');
            const openHelp = document.getElementById('openHelp');
            const closeHelp = document.getElementById('closeHelp');
            const closeHelpBtn = document.getElementById('closeHelpBtn');

          
            
           
      
            // --- Open Help modal (Need help?) ---
            if (openHelp) {
                openHelp.addEventListener('click', function(e) {
                    e.preventDefault();
                    helpModal.style.display = 'flex';
                    document.body.style.overflow = 'hidden';
                });
            }

            // Close Help modal (X)
            if (closeHelp) {
                closeHelp.addEventListener('click', function() {
                    helpModal.style.display = 'none';
                    document.body.style.overflow = 'auto';
                });
            }
            if (closeHelpBtn) {
                closeHelpBtn.addEventListener('click', function() {
                    helpModal.style.display = 'none';
                    document.body.style.overflow = 'auto';
                });
            }

            // Close modal on outside click
            window.addEventListener('click', function(e) {
                if (e.target === helpModal) {
                    helpModal.style.display = 'none';
                    document.body.style.overflow = 'auto';
                }
            });

            
            // Trigger initial strength check
            if (signupPassword) {
                signupPassword.dispatchEvent(new Event('input'));
            }
        });
    </script>

</body>

</html>